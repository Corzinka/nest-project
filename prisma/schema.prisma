  company      String
  position     String
  period_start DateTime    @db.Timestamptz(6)
  period_end   DateTime?   @db.Timestamptz(6)
  achievements String?
  time_create  DateTime    @default(now()) @db.Timestamptz(6)
  id_user      String?     @db.Uuid
  is_deleted   Boolean     @default(false)
  cls_profile  cls_profile @relation(fields: [id_profile], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cls_experience_cls_profile_fk")

  @@schema("main")
}

